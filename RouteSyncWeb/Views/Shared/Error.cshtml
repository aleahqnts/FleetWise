@model ErrorViewModel
@{
    ViewData["Title"] = "Something Went Wrong";
}

<div class="err-page">
    <h1 class="err-title">Something went wrong</h1>
    <p class="err-lead">
        The page could not be loaded. Nothing you were working on has been changed.
    </p>

    @if (Model.ShowRequestId)
    {
        <p class="err-ref">
            Reference: <code>@Model.RequestId</code>
        </p>
        <p class="err-note">
            Quote this reference when reporting the problem. It matches the entry in the
            server log for this request.
        </p>
    }

    <a class="err-back" asp-controller="Dashboard" asp-action="Index">Back to Dashboard</a>
</div>
