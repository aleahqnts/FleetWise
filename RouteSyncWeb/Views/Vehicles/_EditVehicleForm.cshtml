@model EditVehicleViewModel
@*
    Edit vehicle form, fetched per vehicle into the edit modal. Edits the vehicle
    Profile (Plate Number + Route) only; posts to VehiclesController.Edit (PRG + TempData).
    Maintenance status / incident lifecycle is handled in the View modal, not here.
*@
<form asp-action="Edit" asp-controller="Vehicles" method="post">
    <input type="hidden" asp-for="VehicleId" />
    <div class="modal-header">
        <h5 class="modal-title vh-modal-title">Edit Vehicle</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>
    <div class="modal-body vh-modal-body">

        @* Vehicle Profile *@
        <div class="vh-section-header">Vehicle Profile</div>
        <div class="vh-section-body">
            <div class="vh-form-row">
                <label>Vehicle ID:</label>
                <input type="text" class="vh-form-input" value="@Model.VehicleId" disabled />
            </div>
            <div class="vh-form-row">
                <label asp-for="PlateNumber">Plate Number:</label>
                <input asp-for="PlateNumber" class="vh-form-input" />
                <span asp-validation-for="PlateNumber" class="vh-field-error"></span>
            </div>
            <div class="vh-form-row">
                <label asp-for="RouteId">Route:</label>
                <div class="vh-select-wrap" style="width:100%;">
                    <select asp-for="RouteId" class="vh-form-input" style="appearance:none;"
                            asp-items="Model.RouteOptions">
                        <option value="">Select route…</option>
                    </select>
                    <span class="vh-select-arrow">
                        <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9" /></svg>
                    </span>
                </div>
                <span asp-validation-for="RouteId" class="vh-field-error"></span>
            </div>
        </div>

    </div>
    <div class="modal-footer">
        <button type="button" class="vh-btn vh-btn--outline" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="vh-btn vh-btn--primary">Save Changes</button>
    </div>
</form>

@* Fleet membership is its own decision, so it posts separately from the profile. *@
<div class="vh-section-header">
    <span>Fleet Membership</span>
    @if (Model.Retired)
    {
        <span class="vh-section-badge vh-badge--oos">Retired</span>
    }
</div>
<div class="vh-section-body">
    @if (Model.Retired)
    {
        <div class="vh-oos-banner">
            This bus has left the fleet@(string.IsNullOrWhiteSpace(Model.RetiredReason) ? "" : $": {Model.RetiredReason}").
            It is hidden from the registry and cannot be scheduled. Its trips and
            inspections are kept.
        </div>
        <form asp-action="SetRetired" asp-controller="Vehicles" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="vehicleId" value="@Model.VehicleId" />
            <input type="hidden" name="retired" value="false" />
            <p class="vh-action-hint">
                <strong>Restore</strong> brings the bus back to the registry. It returns out
                of service, so its roadworthiness is decided separately.
            </p>
            <button type="submit" class="vh-btn vh-btn--outline">Restore to Fleet</button>
        </form>
    }
    else
    {
        <form asp-action="SetRetired" asp-controller="Vehicles" method="post"
              onsubmit="return confirm('Retire @Model.VehicleId from the fleet? It will be hidden from the registry and cannot be scheduled. This can be undone.');">
            @Html.AntiForgeryToken()
            <input type="hidden" name="vehicleId" value="@Model.VehicleId" />
            <input type="hidden" name="retired" value="true" />
            <p class="vh-action-hint">
                <strong>Retire</strong> is for a bus that is not coming back: sold, scrapped
                or written off. It leaves the registry and every assignment list, and its
                history is kept. Use <strong>Mark Out of Service</strong> instead for a bus
                that is off the road today.
            </p>
            <div class="vh-form-row">
                <label for="retiredReason">Reason:</label>
                <input type="text" id="retiredReason" name="reason" class="vh-form-input"
                       maxlength="200" placeholder="Sold, scrapped, written off…" />
            </div>
            <button type="submit" class="vh-btn vh-btn--danger">Retire Bus</button>
        </form>
    }
</div>
