@model VehiclesIndexViewModel
@{
    ViewData["Title"] = "Vehicles";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@* PAGE TITLE *@
<h2 class="vh-title">Vehicles</h2>

@if (TempData["Success"] is string successMsg)
{
    <div class="vh-alert vh-alert--success" role="alert">@successMsg</div>
}
@if (TempData["Error"] is string errorMsg)
{
    <div class="vh-alert vh-alert--error" role="alert">@errorMsg</div>
}

@* SUMMARY CARDS *@
<div class="vh-cards">
    <a href="@Url.Action("Index")"
       class="vh-card vh-card--click @(string.IsNullOrEmpty(Model.SelectedStatus)
                                        && string.IsNullOrEmpty(Model.SelectedCondition)
                                        && string.IsNullOrEmpty(Model.SelectedRoute)
                                        && string.IsNullOrEmpty(Model.SearchTerm) ? "vh-card--active" : "")"
       title="Show every vehicle">
        <div class="vh-card-icon vh-card-icon--green">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M8 6v6" /><path d="M15 6v6" /><path d="M2 12h19.6" />
                <path d="M18 18h3s.5-1.7.8-2.8c.1-.4.2-.8.2-1.2 0-.4-.1-.8-.2-1.2l-1.4-5C20.1 6.8 19.1 6 18 6H4a2 2 0 0 0-2 2v10h3" />
                <circle cx="7" cy="18" r="2" /><path d="M9 18h5" /><circle cx="16" cy="18" r="2" />
            </svg>
        </div>
        <div class="vh-card-text">
            <span class="vh-card-label">Total Vehicles</span>
            <span class="vh-card-value">@Model.TotalVehicles</span>
        </div>
    </a>

    <a href="@Url.Action("Index", new { status = "Flagged", route = Model.SelectedRoute, search = Model.SearchTerm })"
       @* condition is deliberately omitted: a card sets one filter, not two. *@
       class="vh-card vh-card--click @(Model.SelectedStatus == "Flagged" ? "vh-card--active" : "")"
       title="Show only flagged vehicles">
        <div class="vh-card-icon vh-card-icon--red">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10" /><line x1="8" y1="12" x2="16" y2="12" />
            </svg>
        </div>
        <div class="vh-card-text">
            <span class="vh-card-label">Flagged Vehicles</span>
            <span class="vh-card-value">@Model.FlaggedVehicles</span>
        </div>
    </a>

    <a href="@Url.Action("Index", new { condition = "Under Repair", route = Model.SelectedRoute, search = Model.SearchTerm })"
       class="vh-card vh-card--click @(Model.SelectedCondition == "Under Repair" ? "vh-card--active" : "")"
       title="Show only vehicles under repair">
        <div class="vh-card-icon vh-card-icon--amber">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="12" /><line x1="12" y1="16" x2="12.01" y2="16" />
            </svg>
        </div>
        <div class="vh-card-text">
            <span class="vh-card-label">Scheduled Maintenance</span>
            <span class="vh-card-value">@Model.ScheduledMaintenance</span>
        </div>
    </a>

</div>

@* TOOLBAR *@
<div class="vh-toolbar">
    <button type="button" class="vh-btn vh-btn--primary" data-bs-toggle="modal" data-bs-target="#addVehicleModal">+ Add Vehicle</button>

    <form method="get" class="vh-search-form">
        <input type="hidden" name="route" value="@Model.SelectedRoute" />
        <input type="hidden" name="status" value="@Model.SelectedStatus" />
        <input type="hidden" name="condition" value="@Model.SelectedCondition" />
        <div class="vh-search-wrap">
            <span class="vh-search-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none"
                     stroke="#9AA5B4" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                    <circle cx="11" cy="11" r="8" />
                    <line x1="21" y1="21" x2="16.65" y2="16.65" />
                </svg>
            </span>
            <input type="text" name="search" value="@Model.SearchTerm" class="vh-search-input" placeholder="Search by ID or plate" />
        </div>
    </form>
</div>

@* VEHICLE INFORMATION TABLE CARD *@
<div class="vh-card-table">
    <div class="vh-card-header">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
            <polyline points="14 2 14 8 20 8" />
            <line x1="16" y1="13" x2="8" y2="13" />
            <line x1="16" y1="17" x2="8" y2="17" />
            <line x1="10" y1="9" x2="8" y2="9" />
        </svg>
        <span>Vehicle Information</span>
    </div>

    <div class="vh-table-wrap">
        <table class="vh-table">
            <thead>
                <tr>
                    <th>Vehicle ID</th>
                    <th>Route</th>
                    <th>Status</th>
                    <th>Maintenance</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody id="vehiclesTableBody">
                <tr>
                    <td colspan="5" class="vh-table-loading">
                        <div class="vh-spinner"></div>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

@await Html.PartialAsync("_AddVehicleModal", (AddVehicleViewModel)ViewBag.AddVehicleModel)
@await Html.PartialAsync("_ViewVehicleModal")
@await Html.PartialAsync("_EditVehicleModal")
@await Html.PartialAsync("_CameraCalibrateModal")

@* Booking a bus into the shop. The work is named from the inspection catalogue where
   it matches one, so a fault raised here and by a driver stays one line. *@
<div id="vhScheduleModal" class="vh-action-overlay" style="display:none;" data-dialog-close="vhScheduleCancel">
    <div class="vh-action-box vh-action-box--wide">
        <h3 class="vh-action-title">Schedule Maintenance</h3>
        <p class="vh-action-desc">The bus goes out of service until this work is closed.</p>
        <p id="vhScheduleError" class="vh-action-error" style="display:none;"></p>

        <div class="vh-items-edit" id="vhScheduleList"></div>

        <div class="vh-form-row">
            <label for="vhScheduleOther">Other:</label>
            <input type="text" id="vhScheduleOther" class="vh-form-input" maxlength="200"
                   placeholder="Work not listed above, such as aircon service or repaint" />
        </div>

        <textarea id="vhScheduleNote" class="vh-form-input vh-action-note" rows="2"
                  placeholder="Note (optional): who is doing the work, when it is booked"></textarea>

        <p class="vh-action-foot">
            Each item you tick, and anything under Other, becomes a job on the order to be
            closed one by one. The note explains the booking and closes nothing.
        </p>

        <div class="vh-action-btns">
            <button type="button" class="vh-btn vh-btn--outline" onclick="vhScheduleCancel()">Cancel</button>
            <button type="button" class="vh-btn vh-btn--primary" id="vhScheduleSave">Schedule</button>
        </div>
    </div>
</div>

@* The maintenance update dialog, opened from the vehicle details. Each open fault is
   given an outcome; saving with none left open closes the order and un-grounds the bus. *@
<div id="vhItemsModal" class="vh-action-overlay" style="display:none;" data-dialog-close="vhItemsCancel">
    <div class="vh-action-box vh-action-box--wide">
        <h3 class="vh-action-title">Update Maintenance</h3>
        <p class="vh-action-desc" id="vhItemsDesc"></p>
        <p id="vhItemsError" class="vh-action-error" style="display:none;"></p>
        <div id="vhItemsList" class="vh-items-edit"></div>
        <textarea id="vhItemsNote" class="vh-form-input vh-action-note" rows="2"
                  placeholder="Note (optional): progress, parts on order, who is working on it…"></textarea>
        <p id="vhItemsFoot" class="vh-item-summary"></p>
        <div class="vh-action-btns">
            <button type="button" class="vh-btn vh-btn--outline" onclick="vhItemsCancel()">Cancel</button>
            <button type="button" class="vh-btn vh-btn--primary" id="vhItemsSave">Save</button>
        </div>
    </div>
</div>

@* The inspection checklist, opened from the vehicle details. It sits beside that
   dialog rather than inside it, so closing one never disturbs the other. *@
<div class="modal fade vh-modal" id="inspectionChecklistModal" tabindex="-1"
     aria-labelledby="inspectionChecklistLabel" aria-hidden="true">
    <div class="modal-dialog vh-modal-sm modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title vh-modal-title" id="inspectionChecklistLabel">Inspection Checklist</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body vh-modal-body" id="vhChecklistBody"></div>
        </div>
    </div>
</div>

@* Antiforgery token for the View-modal fetch POSTs (add note / resolve / out-of-service). *@
@Html.AntiForgeryToken()

@* Shared action overlay for scheduling maintenance and taking a bus out of service. Not
   Bootstrap) so it stacks above the View modal without nesting issues. *@
<div id="vhActionModal" class="vh-action-overlay" data-dialog-close="vhActionCancel" style="display:none;">
    <div class="vh-action-box">
        <h3 id="vhActionTitle" class="vh-action-title"></h3>
        <p id="vhActionDesc" class="vh-action-desc"></p>
        <p id="vhActionError" class="vh-action-error" style="display:none;"></p>
        <textarea id="vhActionNote" class="vh-form-input vh-action-note" rows="3" placeholder="Reason / details…"></textarea>
        <div class="vh-action-btns">
            <button type="button" class="vh-btn vh-btn--outline" onclick="vhActionCancel()">Cancel</button>
            <button type="button" class="vh-btn vh-btn--primary" id="vhActionConfirm">Confirm</button>
        </div>
    </div>
</div>

<script>
    // Proxy endpoints for the camera calibration overlay. The service key stays on the
    // server, so the browser only ever calls these.
    window.camUrls = {
        state: '@Url.Action("CameraState", "Vehicles")',
        wake: '@Url.Action("CameraWake", "Vehicles")',
        snapshot: '@Url.Action("CameraSnapshot", "Vehicles")',
        save: '@Url.Action("CameraSave", "Vehicles")'
    };
</script>
<script src="~/js/camera-calib.js"></script>

<script>
    // Copies the checklist built with the vehicle details into its own dialog. The
    // markup is cloned rather than rebuilt, so the two always agree.
    // The open order being edited, and the outcome chosen for each of its items.
    let vhItemsLogId = null;

    function vhOpenItems(logId) {
        const source = document.getElementById('vhItemsSource');
        if (!source) return;

        vhItemsLogId = logId;
        vhItemsError('');
        document.getElementById('vhItemsNote').value = '';
        document.getElementById('vhItemsNote').oninput = vhItemsFoot;
        document.getElementById('vhItemsList').replaceChildren(source.content.cloneNode(true));
        // Each row is settled once on open, so an item already called a misreport shows
        // the reason it was given.
        // Each row remembers how it arrived, so the dialog can tell whether anything
        // has actually moved.
        document.querySelectorAll('#vhItemsList .vh-item-edit').forEach(function (row) {
            row.dataset.initial = row.dataset.state;
            vhItemsChanged(row);
        });
        vhItemsFoot();
        document.getElementById('vhItemsModal').style.display = 'flex';
    }

    function vhItemsCancel() {
        document.getElementById('vhItemsModal').style.display = 'none';
        window.focusFrontDialog();
    }

    function vhItemsError(message) {
        const el = document.getElementById('vhItemsError');
        el.textContent = message;
        el.style.display = message ? 'block' : 'none';
    }

    // Each row carries its own outcome. Ticking closes a fault as fixed; calling it a
    // misreport is a separate choice, offered only where the fault does not ground the bus.
    function vhItemsTick(row) {
        row.dataset.state = row.querySelector('input[type=checkbox]').checked ? 'fixed' : 'open';
        vhItemsChanged(row);
    }

    function vhItemsDismiss(row) {
        const dismissing = row.dataset.state !== 'dismissed';
        row.dataset.state = dismissing ? 'dismissed' : 'open';
        row.querySelector('input[type=checkbox]').checked = false;
        vhItemsChanged(row);
        if (dismissing) row.querySelector('.vh-item-why input').focus();
    }

    // A reason is asked for only when a fault is being called a misreport, and the count
    // below says what saving now would do.
    function vhItemsChanged(row) {
        row.querySelector('.vh-item-why').style.display =
            row.dataset.state === 'dismissed' ? 'block' : 'none';
        vhItemsFoot();
    }

    function vhItemsFoot() {
        const rows = Array.from(document.querySelectorAll('#vhItemsList .vh-item-edit'));
        const left = rows.filter(r => r.dataset.state === 'open').length;
        const moved = rows.some(r => r.dataset.state !== r.dataset.initial);
        const note = document.getElementById('vhItemsNote').value.trim();

        // Saving with nothing moved and nothing written would record an empty entry.
        document.getElementById('vhItemsSave').disabled = !moved && !note;

        // Nothing to say until something has moved: an unusable Save says it already.
        document.getElementById('vhItemsFoot').textContent =
            !moved && !note ? ''
            : left === 0 ? 'Saving with nothing open closes this order and returns the bus to service.'
            : left + ' of ' + rows.length + ' would stay open.';
    }

    document.addEventListener('DOMContentLoaded', function () {
        const save = document.getElementById('vhItemsSave');
        if (!save) return;

        save.addEventListener('click', async function () {
            const updates = Array.from(document.querySelectorAll('#vhItemsList .vh-item-edit'))
                .map(function (row) {
                    return {
                        itemId: Number(row.getAttribute('data-item-id')),
                        state: row.dataset.state,
                        note: row.querySelector('.vh-item-why input').value.trim()
                    };
                });

            save.disabled = true;
            try {
                const r = await vhPostResult('@Url.Action("UpdateMaintenanceItems", "Vehicles")',
                    {
                        logId: vhItemsLogId,
                        updates: JSON.stringify(updates),
                        note: document.getElementById('vhItemsNote').value.trim()
                    });
                if (r.ok) { vhItemsCancel(); vhReloadModal(); loadVehicleRows(); }
                else { vhItemsError(r.message || 'Could not save this update.'); }
            } finally {
                save.disabled = false;
            }
        });
    });

    // History is rendered in full and trimmed here, so changing how much is shown costs
    // no round trip.
    // Pages a list that is already rendered: every row is in the DOM, so turning a page
    // only changes which of them are visible. Used by the history and by past orders.
    function vhPage(listId, pagerId, perPage, page) {
        const list = document.getElementById(listId);
        if (!list) return;

        const rows = Array.from(list.children);
        const pages = Math.max(1, Math.ceil(rows.length / perPage));
        const current = Math.min(Math.max(1, page || 1), pages);
        const from = (current - 1) * perPage;

        rows.forEach(function (row, i) {
            row.style.display = (i >= from && i < from + perPage) ? '' : 'none';
        });

        const pager = document.getElementById(pagerId);
        if (!pager) return;
        pager.replaceChildren();
        if (pages < 2) return;

        function step(label, target) {
            const b = document.createElement('button');
            b.type = 'button';
            b.className = 'vh-page';
            b.textContent = label;
            if (target === null) b.disabled = true;
            else b.onclick = function () { vhPage(listId, pagerId, perPage, target); };
            return b;
        }

        // The first page, the last, and the ones either side of the current. Everything
        // else collapses into a gap, so the control stays one line however long the list.
        const wanted = new Set([1, pages, current, current - 1, current + 1]);
        pager.appendChild(step('‹', current > 1 ? current - 1 : null));

        let previous = 0;
        for (let n = 1; n <= pages; n++) {
            if (!wanted.has(n)) continue;
            if (n - previous > 1) {
                const gap = document.createElement('span');
                gap.className = 'vh-page-gap';
                gap.textContent = '…';
                pager.appendChild(gap);
            }
            const b = step(String(n), n);
            if (n === current) b.classList.add('vh-page--on');
            pager.appendChild(b);
            previous = n;
        }

        pager.appendChild(step('›', current < pages ? current + 1 : null));
    }

    function vhOpenChecklist() {
        const source = document.getElementById('vhChecklistSource');
        const body = document.getElementById('vhChecklistBody');
        const dialog = document.getElementById('inspectionChecklistModal');
        if (!source || !body || !dialog) return;

        body.replaceChildren(source.content.cloneNode(true));

        bootstrap.Modal.getOrCreateInstance(dialog).show();
    }
</script>

<script>
    // Load the vehicle table rows in the background so the page itself renders instantly
    // (server-rendered HTML fetched into the table body).
    document.addEventListener('DOMContentLoaded', function () {
        loadVehicleRows();

        // Delegated: rows are injected via fetch, so listen on the (static) tbody. View/Edit
        // clicks fetch that vehicle's data into the modal; Bootstrap opens it in parallel.
        document.getElementById('vehiclesTableBody').addEventListener('click', function (e) {
            const viewBtn = e.target.closest('[data-bs-target="#viewVehicleModal"]');
            if (viewBtn) {
                loadVehicleDetails(viewBtn.getAttribute('data-vehicle-id'));
                return;
            }
            const editBtn = e.target.closest('[data-bs-target="#editVehicleModal"]');
            if (editBtn) {
                loadVehicleEditForm(editBtn.getAttribute('data-vehicle-id'));
            }
        });

        // Auto-reopen the relevant modal after a failed POST (validation errors preserved).
        const openModal = '@(ViewBag.OpenModal ?? "")';
        if (openModal === 'AddVehicle') {
            new bootstrap.Modal(document.getElementById('addVehicleModal')).show();
        } else if (openModal === 'EditVehicle') {
            new bootstrap.Modal(document.getElementById('editVehicleModal')).show();
        }
    });

    function loadVehicleDetails(id) {
        window.__vhCurrentVehicle = id;
        const content = document.getElementById('viewVehicleContent');
        content.innerHTML = '<div class="vh-modal-loading"><div class="vh-spinner"></div></div>';
        fetch('@Url.Action("Details", "Vehicles")?id=' + encodeURIComponent(id))
            .then(function (response) {
                if (!response.ok) throw new Error();
                return response.text();
            })
            .then(function (html) {
                content.innerHTML = html;
                // The panel arrives with every entry rendered; only the newest few show.
                vhPage('vhHistoryList', 'vhHistoryPager', 6, 1);
                vhPage('vhPastList', 'vhPastPager', 5, 1);
            })
            .catch(function () {
                content.innerHTML = '<div class="vh-modal-loading vh-modal-error">Failed to load vehicle details.</div>';
            });
    }

    function loadVehicleEditForm(id) {
        const content = document.getElementById('editVehicleContent');
        content.innerHTML = '<div class="vh-modal-loading"><div class="vh-spinner"></div></div>';
        fetch('@Url.Action("EditForm", "Vehicles")?id=' + encodeURIComponent(id))
            .then(function (response) {
                if (!response.ok) throw new Error();
                return response.text();
            })
            .then(function (html) { content.innerHTML = html; })
            .catch(function () {
                content.innerHTML = '<div class="vh-modal-loading vh-modal-error">Failed to load vehicle.</div>';
            });
    }

    function loadVehicleRows() {
        const tbody = document.getElementById('vehiclesTableBody');
        fetch('@Url.Action("VehicleRows", "Vehicles")' + window.location.search)
            .then(function (response) { return response.text(); })
            .then(function (html) { tbody.innerHTML = html; })
            .catch(function () {
                tbody.innerHTML = '<tr><td colspan="6" class="vh-empty">Failed to load vehicles.</td></tr>';
            });
    }

    // Flag review actions (buttons live inside the fetched View-modal partial).
    function vhToken() {
        const el = document.querySelector('input[name="__RequestVerificationToken"]');
        return el ? el.value : '';
    }

    async function vhPost(url, params) {
        const res = await fetch(url, {
            method: 'POST',
            headers: { 'RequestVerificationToken': vhToken(), 'Content-Type': 'application/x-www-form-urlencoded' },
            body: new URLSearchParams(params)
        });
        return res.ok;
    }

    async function vhPostResult(url, params) {
        const res = await fetch(url, {
            method: 'POST',
            headers: { 'RequestVerificationToken': vhToken(), 'Content-Type': 'application/x-www-form-urlencoded' },
            body: new URLSearchParams(params)
        });
        return { ok: res.ok, message: res.ok ? '' : (await res.text()) };
    }

    function vhReloadModal() { loadVehicleDetails(window.__vhCurrentVehicle); }


    // Reusable action overlay (schedule maintenance / take out of service). Custom overlay,
    // not Bootstrap, so it stacks cleanly above the View modal.
    function vhOpenAction(opts) {
        document.getElementById('vhActionTitle').textContent = opts.title;
        document.getElementById('vhActionDesc').textContent = opts.desc || '';
        const ta = document.getElementById('vhActionNote'); ta.value = '';
        vhActionError('');
        const btn = document.getElementById('vhActionConfirm');
        btn.textContent = opts.confirmLabel || 'Confirm';
        btn.className = 'vh-btn ' + (opts.danger ? 'vh-btn--danger' : 'vh-btn--primary');
        btn.disabled = false;
        let inFlight = false;   // block button-spam -> duplicate POSTs / maintenance logs
        btn.onclick = async function () {
            if (inFlight) return;
            inFlight = true;
            btn.disabled = true;
            try {
                const note = ta.value.trim();
                await opts.onConfirm(note);
            } finally {
                // On success the overlay is hidden by onConfirm; re-enable so a failed
                // attempt can be retried.
                inFlight = false;
                btn.disabled = false;
            }
        };
        document.getElementById('vhActionModal').style.display = 'flex';
        setTimeout(function () { ta.focus(); }, 50);
    }
    function vhActionCancel() {
        document.getElementById('vhActionModal').style.display = 'none';
        // Hands the keyboard back to whatever is still open behind it.
        window.focusFrontDialog();
    }

    function vhActionError(message) {
        const el = document.getElementById('vhActionError');
        el.textContent = message;
        el.style.display = message ? 'block' : 'none';
    }



    let vhScheduleVehicle = null;

    function vhScheduleMaintenance(vehicleId) {
        const source = document.getElementById('vhCatalogueSource');
        if (!source) return;

        vhScheduleVehicle = vehicleId;
        vhScheduleError('');
        document.getElementById('vhScheduleOther').value = '';
        document.getElementById('vhScheduleNote').value = '';
        document.getElementById('vhScheduleList').replaceChildren(source.content.cloneNode(true));
        document.getElementById('vhScheduleModal').style.display = 'flex';
    }

    function vhScheduleCancel() {
        document.getElementById('vhScheduleModal').style.display = 'none';
        window.focusFrontDialog();
    }

    function vhScheduleError(message) {
        const el = document.getElementById('vhScheduleError');
        el.textContent = message;
        el.style.display = message ? 'block' : 'none';
    }

    document.addEventListener('DOMContentLoaded', function () {
        const save = document.getElementById('vhScheduleSave');
        if (!save) return;

        save.addEventListener('click', async function () {
            const picked = Array.from(
                document.querySelectorAll('#vhScheduleList input[type=checkbox]:checked'))
                .map(box => box.value);

            const other = document.getElementById('vhScheduleOther').value.trim();
            if (other) picked.push(other);

            if (picked.length === 0) {
                vhScheduleError('Select at least one item, or describe the work under Other.');
                return;
            }

            save.disabled = true;
            try {
                const r = await vhPostResult('@Url.Action("ScheduleMaintenance", "Vehicles")', {
                    vehicleId: vhScheduleVehicle,
                    items: JSON.stringify(picked),
                    note: document.getElementById('vhScheduleNote').value.trim()
                });
                if (r.ok) { vhScheduleCancel(); vhReloadModal(); loadVehicleRows(); }
                else { vhScheduleError(r.message || 'Could not schedule this work.'); }
            } finally {
                save.disabled = false;
            }
        });
    });

    // Retiring and restoring go through the same overlay as the other vehicle
    // actions, and take their reason from its note field.
    function vhRetire(vehicleId) {
        vhOpenAction({
            title: 'Retire Bus',
            desc: 'For a bus that is not coming back: sold, scrapped or written off. It leaves the registry and every assignment list. Its history is kept and this can be undone.',
            confirmLabel: 'Retire Bus', danger: true,
            onConfirm: async function (note) {
                const r = await vhPostResult('@Url.Action("SetRetired", "Vehicles")',
                    { vehicleId: vehicleId, retired: true, reason: note });
                if (r.ok) { vhActionCancel(); vhCloseEdit(); loadVehicleRows(); }
                else { vhActionError(r.message || 'Could not retire this bus.'); }
            }
        });
    }

    function vhRestore(vehicleId) {
        vhOpenAction({
            title: 'Restore Bus',
            desc: 'Brings the bus back to the registry. It returns out of service, so its roadworthiness is decided separately.',
            confirmLabel: 'Restore Bus',
            onConfirm: async function () {
                const r = await vhPostResult('@Url.Action("SetRetired", "Vehicles")',
                    { vehicleId: vehicleId, retired: false });
                if (r.ok) { vhActionCancel(); vhCloseEdit(); loadVehicleRows(); }
                else { vhActionError(r.message || 'Could not restore this bus.'); }
            }
        });
    }

    // The listing behind the dialog changes, so the edit view it was opened from is
    // closed rather than left describing a stale row.
    function vhCloseEdit() {
        const edit = document.getElementById('editVehicleModal');
        if (edit) bootstrap.Modal.getOrCreateInstance(edit).hide();
    }

    function vhMarkOutOfService(vehicleId, logId) {
        vhOpenAction({
            title: 'Take Out of Service',
            desc: 'The bus is flagged and cannot be deployed until it is returned to service or resolved.',
            confirmLabel: 'Mark Out of Service', danger: true,
            onConfirm: async function (note) {
                const params = { vehicleId: vehicleId, outOfService: true };
                if (logId !== null && logId !== undefined) params.logId = logId;
                if (note) params.note = note;
                const r = await vhPostResult('@Url.Action("SetServiceState", "Vehicles")', params);
                if (r.ok) { vhActionCancel(); vhReloadModal(); loadVehicleRows(); }
                else { vhActionError(r.message || 'Could not update the service state.'); }
            }
        });
    }

    function vhSetService(vehicleId, outOfService, logId) {
        vhOpenAction({
            title: outOfService ? 'Take Out of Service' : 'Return to Service',
            desc: outOfService
                ? 'The bus is flagged and cannot be deployed until it is returned to service or resolved.'
                : 'Return this bus to service so dispatch can assign it again. Add a note (optional).',
            confirmLabel: outOfService ? 'Mark Out of Service' : 'Return to Service',
            danger: outOfService,
            onConfirm: async function (note) {
                const params = { vehicleId: vehicleId, outOfService: outOfService };
                if (logId !== null && logId !== undefined) params.logId = logId;
                if (note) params.note = note;
                const r = await vhPostResult('@Url.Action("SetServiceState", "Vehicles")', params);
                if (r.ok) { vhActionCancel(); vhReloadModal(); loadVehicleRows(); }
                else { vhActionError(r.message || 'Could not update the service state.'); }
            }
        });
    }
</script>

@section TopbarContent {
    <form method="get" class="vh-filters">
        <input type="hidden" name="search" value="@Model.SearchTerm" />
        <div class="vh-filter">
            <label class="vh-filter-label">Route:</label>
            <div class="vh-select-wrap">
                <select name="route" class="vh-select" onchange="this.form.submit()">
                    <option value="">All Routes</option>
                    @foreach (var r in Model.RouteOptions)
                    {
                        <option value="@r.Value" selected="@(r.Value == Model.SelectedRoute)">@r.Text</option>
                    }
                </select>
                <span class="vh-select-arrow">
                    <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9" /></svg>
                </span>
            </div>
        </div>
        <div class="vh-filter">
            <label class="vh-filter-label">Status:</label>
            <div class="vh-select-wrap">
                <select name="status" class="vh-select" onchange="this.form.submit()">
                    <option value="">All</option>
                    @foreach (var s in Model.StatusOptions)
                    {
                        <option value="@s" selected="@(s == Model.SelectedStatus)">@s</option>
                    }
                </select>
                <span class="vh-select-arrow">
                    <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9" /></svg>
                </span>
            </div>
        </div>
        <div class="vh-filter">
            <label class="vh-filter-label">Issues:</label>
            <div class="vh-select-wrap">
                <select name="condition" class="vh-select" onchange="this.form.submit()">
                    <option value="">All</option>
                    @foreach (var c in Model.ConditionOptions)
                    {
                        <option value="@c" selected="@(c == Model.SelectedCondition)">@c</option>
                    }
                </select>
                <span class="vh-select-arrow">
                    <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9" /></svg>
                </span>
            </div>
        </div>
    </form>
}

<style>
    :root {
        --vh-teal: #4AADA8;
        --vh-teal-light: #E8F6F5;
        --vh-navy: #2F3B82;
        --vh-text: #2D3748;
        --vh-muted: #9AA5B4;
        --vh-border: #E8ECF0;
        --vh-bg: #F8F9FA;
        --vh-white: #FFFFFF;
        --vh-radius: 14px;
        --vh-shadow: 0 1px 4px rgba(0,0,0,.06);
    }

    /* Page title. */
    .vh-title {
        font-size: 1.6rem;
        font-weight: 700;
        color: var(--vh-text);
        font-family: 'Segoe UI', sans-serif;
        margin-bottom: 20px;
    }

    /* Summary cards. */
    .vh-cards {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
        margin-bottom: 22px;
    }

    .vh-card {
        background: var(--vh-white);
        border: 1px solid var(--vh-border);
        border-radius: var(--vh-radius);
        box-shadow: var(--vh-shadow);
        padding: 20px 22px;
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .vh-card-icon {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .vh-card-icon--green { background: #E8F8EE; color: #27AE60; }
    .vh-card-icon--red   { background: #FDECEC; color: #E53E3E; }

    .vh-form-input--fixed {
        background: #F4F6F8;
        color: #6B7280;
        cursor: default;
    }

    .vh-field-note {
        font-size: 0.72rem;
        color: #9AA3B2;
        margin-top: 2px;
    }

    .vh-btn--sm {
        padding: 5px 10px;
        font-size: 0.78rem;
        margin-top: 6px;
    }

    #vhChecklistBody {
        padding: 18px 24px 24px;
    }

    /* Sits above the vehicle details, so it carries a heavier shadow to read as a
       separate sheet rather than part of the dialog underneath. */
    #inspectionChecklistModal .modal-content {
        box-shadow: 0 24px 60px rgba(15, 30, 60, 0.28);
    }

    /* The faults on the open order. */
    .vh-items {
        list-style: none;
        margin: 10px 0 0;
        padding: 0;
    }

        .vh-items li {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 7px 0;
            font-size: 0.85rem;
            color: #2D3748;
        }

            .vh-items li + li { border-top: 1px solid #F4F6F8; }

    .vh-item-mark {
        width: 16px;
        text-align: center;
        font-weight: 700;
        flex: none;
    }

    .vh-item--open .vh-item-mark { color: #C99A2E; }

    .vh-item--closed {
        color: #9AA3B2;
    }

        .vh-item--closed .vh-item-mark { color: #27AE60; }

        .vh-item--closed .vh-item-label { text-decoration: line-through; }

    .vh-item-label { flex: 1; }

    .vh-item-crit {
        padding: 1px 7px;
        border-radius: 999px;
        background: #FDF3E3;
        color: #B87A15;
        font-size: 0.66rem;
        font-weight: 700;
        flex: none;
    }

    .vh-item-outcome {
        font-size: 0.72rem;
        color: #9AA3B2;
        flex: none;
    }

    .vh-item-note {
        padding: 0 0 7px 25px !important;
        font-size: 0.76rem;
        color: #9AA3B2;
        border-top: none !important;
    }

    .vh-item-summary {
        margin-top: 8px;
        font-size: 0.78rem;
        color: #6B7280;
    }

    .vh-items-edit {
        max-height: 340px;
        overflow-y: auto;
        margin-bottom: 12px;
    }

    .vh-item-edit {
        padding: 10px 2px;
        border-bottom: 1px solid #F4F6F8;
    }

    .vh-item-edit-top {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .vh-item-check {
        display: flex;
        align-items: center;
        gap: 10px;
        flex: 1;
        min-width: 0;
        cursor: pointer;
    }

        .vh-item-check input {
            width: 17px;
            height: 17px;
            flex: none;
            accent-color: #27AE60;
            cursor: pointer;
        }

    .vh-item-dismiss {
        border: none;
        background: none;
        padding: 0;
        font-size: 0.74rem;
        color: #9AA3B2;
        cursor: pointer;
        flex: none;
        white-space: nowrap;
    }

        .vh-item-dismiss:hover { color: #C0392B; }

    .vh-item-edit[data-state="fixed"] .vh-item-label { text-decoration: line-through; color: #9AA3B2; }

    .vh-item-edit[data-state="dismissed"] .vh-item-label { text-decoration: line-through; color: #9AA3B2; }

    .vh-item-edit[data-state="dismissed"] .vh-item-dismiss { color: #C0392B; font-weight: 600; }

    .vh-item-why {
        margin-top: 8px;
        padding-left: 27px;
    }

    /* A whole section folded behind its own header. Closed on open, since the record
       of a bus is worth reaching for rather than scrolling past. */
    .vh-fold > summary.vh-section-header { cursor: pointer; list-style: none; }
    .vh-fold > summary.vh-section-header::-webkit-details-marker { display: none; }
    .vh-fold > summary.vh-section-header:hover { color: var(--vh-navy); }

    /* The arrow rides with the title so the badge stays at the far edge. */
    .vh-fold-title::before {
        content: "›";
        display: inline-block;
        margin-right: 9px;
        font-size: 1rem;
        line-height: 1;
        transition: transform .15s ease;
    }

    .vh-fold[open] > summary .vh-fold-title::before { transform: rotate(90deg); }

    /* Pager, shared by the history and past orders. */
    .vh-page-bar {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 4px;
        margin-top: 12px;
        flex-wrap: wrap;
    }

    .vh-page {
        min-width: 26px;
        height: 26px;
        padding: 0 6px;
        border: 1px solid var(--vh-border);
        border-radius: 6px;
        background: #fff;
        color: var(--vh-text);
        font-family: 'Segoe UI', sans-serif;
        font-size: 0.76rem;
        line-height: 1;
        cursor: pointer;
    }

    .vh-page:hover:not(:disabled) { background: var(--vh-bg); }
    .vh-page:disabled { color: #C7CDD8; cursor: default; }

    .vh-page--on {
        background: var(--vh-navy);
        border-color: var(--vh-navy);
        color: #fff;
        font-weight: 700;
    }

    .vh-page-gap { color: #9AA3B2; font-size: 0.76rem; padding: 0 2px; }

    /* Everything recorded against a bus, newest first. */
    .vh-history {
        list-style: none;
        margin: 0;
        padding: 0;
    }

        .vh-history li {
            display: flex;
            flex-direction: column;
            gap: 2px;
            padding: 9px 0;
            font-size: 0.84rem;
            color: #2D3748;
        }

            .vh-history li + li { border-top: 1px solid #F4F6F8; }

    .vh-history-meta {
        font-size: 0.74rem;
        color: #9AA3B2;
    }

    .vh-history--refused .vh-history-what {
        color: #9B2C2C;
    }

    /* Inspection checklist, one line per item with how it was marked. */
    .vh-cl-summary {
        display: flex;
        flex-direction: column;
        gap: 2px;
        padding: 10px 12px;
        border-radius: 8px;
        font-size: 0.85rem;
        font-weight: 600;
        margin-bottom: 16px;
    }

    .vh-cl-summary--pass { background: #E8F8EE; color: #1E8449; }
    .vh-cl-summary--fail { background: #FDECEC; color: #9B2C2C; }

    .vh-cl-when {
        font-size: 0.75rem;
        font-weight: 400;
        opacity: 0.75;
    }

    .vh-cl-group + .vh-cl-group { margin-top: 16px; }

    .vh-cl-group-label {
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: #9AA3B2;
        padding-bottom: 6px;
        border-bottom: 1px solid #EEF1F5;
        margin-bottom: 2px;
    }

    .vh-cl-list {
        list-style: none;
        margin: 0;
        padding: 0;
    }

        .vh-cl-list li {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 8px 2px;
            font-size: 0.86rem;
            color: #2D3748;
        }

            .vh-cl-list li + li { border-top: 1px solid #F4F6F8; }

    .vh-cl-name { flex: 1; }

    .vh-cl-mark {
        width: 18px;
        height: 18px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.7rem;
        font-weight: 700;
        flex: none;
    }

    .vh-cl--pass .vh-cl-mark { background: #E8F8EE; color: #27AE60; }

    .vh-cl--fail {
        color: #9B2C2C;
        font-weight: 600;
    }

        .vh-cl--fail .vh-cl-mark { background: #FDECEC; color: #C0392B; }

    /* Marks an item that grounds the bus when it fails. */
    .vh-cl-crit {
        padding: 1px 7px;
        border-radius: 999px;
        background: #FDF3E3;
        color: #B87A15;
        font-size: 0.66rem;
        font-weight: 700;
        letter-spacing: 0.03em;
        flex: none;
    }
    .vh-card-icon--amber { background: #FEF6E0; color: #D69E2E; }

    /* Clickable flagged KPI -> filters the table to flagged vehicles. */
    .vh-card--click { cursor: pointer; text-decoration: none; transition: box-shadow .15s, transform .15s; }
    .vh-card--click:hover { box-shadow: 0 6px 18px rgba(229,62,62,.18); transform: translateY(-2px); }
    .vh-card--active { border-color: #3AB5A4; box-shadow: 0 0 0 2px rgba(58,181,164,.18); }

    .vh-card-text {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .vh-card-label {
        font-size: 0.85rem;
        color: var(--vh-muted);
        font-family: 'Segoe UI', sans-serif;
        font-weight: 500;
    }

    .vh-card-value {
        font-size: 1.7rem;
        font-weight: 700;
        color: var(--vh-text);
        font-family: 'Segoe UI', sans-serif;
        line-height: 1.1;
    }

    /* Toolbar. */
    .vh-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 18px;
        flex-wrap: wrap;
    }

    .vh-btn {
        padding: 9px 20px;
        border-radius: 10px;
        font-size: 0.85rem;
