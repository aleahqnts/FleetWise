    /* Alerts. */
    .vh-alert {
        padding: 12px 18px;
        border-radius: var(--vh-radius);
        font-size: 0.875rem;
        font-family: 'Segoe UI', sans-serif;
        font-weight: 500;
        margin-bottom: 16px;
    }

    .vh-alert--success {
        background: var(--vh-teal-light);
        color: var(--vh-teal);
        border: 1px solid var(--vh-teal);
    }

    .vh-alert--error {
        background: #FDECEC;
        color: #E53E3E;
        border: 1px solid #F5B5B5;
