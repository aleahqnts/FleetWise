    /* Topbar filters. */
    .vh-filters {
        display: flex;
        align-items: center;
        gap: 22px;
        flex-wrap: wrap;
    }

    .vh-filter { display: flex; align-items: center; gap: 8px; }

    .vh-filter-label {
        font-size: 0.875rem;
        font-weight: 600;
        color: var(--vh-text);
        font-family: 'Segoe UI', sans-serif;
    }

    .vh-select-wrap { position: relative; display: flex; align-items: center; }

    .vh-select {
        appearance: none;
        padding: 7px 32px 7px 14px;
        border: 1.5px solid var(--vh-border);
        border-radius: 10px;
        font-size: 0.85rem;
        font-family: 'Segoe UI', sans-serif;
        color: var(--vh-text);
        background: var(--vh-bg);
        cursor: pointer;
        outline: none;
        font-weight: 500;
    }

    .vh-select-arrow {
        position: absolute;
        right: 10px;
        pointer-events: none;
        color: var(--vh-text);
        display: flex;
    }

    /* Modals (shared by Add/View/Edit Vehicle). */
    .vh-modal .modal-content {
        border-radius: var(--vh-radius);
        border: 1px solid var(--vh-border);
    }

    .vh-modal .modal-header {
        position: relative;
        justify-content: center;
        border-bottom: 1px solid var(--vh-border);
        padding: 18px 24px;
    }

    .vh-modal .modal-header .btn-close {
