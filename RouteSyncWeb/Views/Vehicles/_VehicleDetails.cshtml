@model VehicleDetailsViewModel
@*
    Vehicle details, fetched per vehicle into the details modal.
    Renders the modal header + body; the shell lives in _ViewVehicleModal.cshtml.
*@
@functions {
    string InspectionClass(string badge) => badge switch
    {
        "Flagged" => "vh-badge--flagged",
        "Passed" => "vh-badge--ok",
        "Resolved" => "vh-badge--ok",
        "Pending" => "vh-badge--pending",
        _ => "vh-badge--default"
    };

    string MaintClass(string status) => status switch
    {
        "No Issues" => "vh-badge--ok",
        "Needs Attention" => "vh-badge--attention",
        "Under Repair" => "vh-badge--repair",
        _ => "vh-badge--default"
    };
}

<div class="modal-header">
    <h5 class="modal-title vh-modal-title">@Model.VehicleId</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
<div class="modal-body vh-modal-body">

    @* Vehicle Profile *@
    <div class="vh-section-header">Vehicle Profile</div>
    <div class="vh-section-body">
        <div class="vh-detail-row"><strong>Plate Number:</strong> @Model.PlateNumber</div>
        <div class="vh-detail-row"><strong>Route:</strong> @Model.RouteName</div>
    </div>

    @* Passenger counter camera, with remote calibration for any bus and no trip required. *@
    <div class="vh-section-header">Passenger Counter</div>
    <div class="vh-section-body">
        @if (!string.IsNullOrEmpty(Model.CounterDeviceId))
        {
            <div class="vh-detail-row"><strong>Counter Phone:</strong> @Model.CounterDeviceId</div>
            <div class="vh-review-actions" style="margin-top:8px;">
                <button type="button" class="vh-btn vh-btn--primary" onclick="camOpen('@Model.VehicleId')">Calibrate Camera</button>
            </div>
        }
        else
        {
            <div class="vh-detail-row vh-detail-empty">No counter phone is bound to this bus.</div>
        }
    </div>

    @* Inspection Log *@
    <div class="vh-section-header">
        <span>Inspection Log</span>
        @if (Model.HasInspection)
        {
            <span class="vh-section-badge @InspectionClass(Model.InspectionBadge)">@Model.InspectionBadge</span>
        }
    </div>
    <div class="vh-section-body">
        @if (Model.HasInspection)
        {
            <div class="vh-detail-row"><strong>Reported By:</strong> @Model.ReportedBy</div>
            <div class="vh-detail-row"><strong>Time of Report:</strong> @Model.TimeOfReport</div>
            <div class="vh-detail-row"><strong>Issue:</strong> @Model.Issue</div>
            @if (Model.InspectionChecklist.Count > 0)
            {
                <button type="button" class="vh-btn vh-btn--outline vh-btn--sm"
                        onclick="vhOpenChecklist()">View inspection checklist</button>

                @* Held here and moved into the checklist dialog on demand, so the
                   markup is built once with the rest of the details. *@
                <template id="vhChecklistSource">
                    @{
                        var allItems = Model.InspectionChecklist.SelectMany(g => g.Items).ToList();
                        var failedCount = allItems.Count(i => !i.Passed);
                    }
                    <div class="vh-cl-summary @(failedCount == 0 ? "vh-cl-summary--pass" : "vh-cl-summary--fail")">
                        @if (failedCount == 0)
                        {
                            <text>All @allItems.Count items passed.</text>
                        }
                        else
                        {
                            <text>@failedCount of @allItems.Count items failed.</text>
                        }
                        <span class="vh-cl-when">@Model.TimeOfReport &middot; @Model.ReportedBy</span>
                    </div>

                    @foreach (var grp in Model.InspectionChecklist)
                    {
                        <div class="vh-cl-group">
                            <div class="vh-cl-group-label">@grp.Section</div>
                            <ul class="vh-cl-list">
                                @foreach (var item in grp.Items)
                                {
                                    <li class="@(item.Passed ? "vh-cl--pass" : "vh-cl--fail")">
                                        <span class="vh-cl-mark">@(item.Passed ? "✓" : "✕")</span>
                                        <span class="vh-cl-name">@item.Item</span>
                                        @if (item.IsCritical)
                                        {
                                            <span class="vh-cl-crit" title="Blocks a trip if it fails">Critical</span>
                                        }
                                    </li>
                                }
                            </ul>
                        </div>
                    }
                </template>
            }
        }
        else
        {
            <div class="vh-detail-row vh-detail-empty">No inspection logged for this vehicle.</div>
        }
    </div>

    @* Maintenance Log *@
    <div class="vh-section-header">
        <span>Maintenance Log</span>
        <span class="vh-maint-head-right">
            <button type="button" class="vh-btn-mini" onclick="vhScheduleMaintenance('@Model.VehicleId')">+ Schedule Maintenance</button>
            <span class="vh-section-badge @MaintClass(Model.CurrentStatus)">@Model.CurrentStatus</span>
        </span>
    </div>
    <div class="vh-section-body">
        @* Only what is wrong now. Anything closed has moved to the history below, and
           the status is already on the header badge. *@
        @if (Model.OpenIncident is not null)
        {
            <div class="vh-detail-row"><strong>@Model.OpenIncident.Summary</strong></div>
            <div class="vh-tl-date">Reported @Model.OpenIncident.Date</div>

            @if (Model.IncidentThreads.Count > 0)
            {
                @foreach (var thread in Model.IncidentThreads)
                {
                    <ul class="vh-thread">
                        @foreach (var n in thread.Notes)
                        {
                            <li>
                                <span class="vh-thread-action">@n.Action</span>
                                @if (!string.IsNullOrWhiteSpace(n.Note))
                                {
                                    <span class="vh-thread-note">@n.Note</span>
                                }
                                <span class="vh-thread-meta">@n.AuthorName &middot; @n.When</span>
                            </li>
                        }
                    </ul>
                }
            }

            @if (Model.OpenLogId.HasValue)
            {
                <div class="vh-note-form">
                    <textarea id="vhNoteInput" class="vh-form-input" rows="2" placeholder="Add a comment or note about this issue…"></textarea>
                    <button type="button" class="vh-btn vh-btn--primary" onclick="vhAddNote(@Model.OpenLogId)">Add Note</button>
                </div>
            }
        }
        else
        {
            <div class="vh-detail-row vh-detail-empty">Nothing outstanding.</div>
        }
    </div>

    @* Flag Review / Actions *@
    @if (Model.OpenLogId.HasValue || Model.OutOfService || Model.IncidentThreads.Count > 0)
    {
        <div class="vh-section-header">
            <span>Flag Review</span>
            @if (Model.OutOfService)
            {
                <span class="vh-section-badge vh-badge--oos">Out of Service</span>
            }
            else if (Model.OpenLogId.HasValue)
            {
                <span class="vh-section-badge vh-badge--flagged">Flagged</span>
            }
        </div>
        <div class="vh-section-body">
            @if (Model.OutOfService)
            {
                @if (Model.OpenIncidentCritical)
                {
                    <div class="vh-oos-banner">
                        Grounded by a failed inspection: <strong>@Model.OpenIncidentSummary</strong>.
                        Any trip on this bus is blocked until it returns to service. Reassign the
                        trip to another bus from Dispatch, or cancel it, if the repair will not be
                        done in time.
                    </div>
                }
                else
                {
                    <div class="vh-oos-banner">This bus is <strong>Out of Service</strong>. Dispatch cannot assign it.</div>
                }
            }

            <p class="vh-action-hint">
                @if (Model.OutOfService)
                {
                    <text>
                        <strong>Resolve</strong> closes the fault and returns the bus to ready.
                        <strong>Return to Service</strong> un-grounds it while leaving the fault
                        open, for a bus that is usable but still being watched. The driver must
                        submit a fresh inspection either way before the trip can start.
                    </text>
                }
                else
                {
                    <text>
                        <strong>Resolve</strong> closes the fault and clears the flag.
                        <strong>Mark Out of Service</strong> grounds the bus, which blocks
                        every trip assigned to it.
                    </text>
                }
            </p>

            <div class="vh-review-actions">
                @if (Model.OpenLogId.HasValue)
                {
                    <button type="button" class="vh-btn vh-btn--resolve" onclick="vhResolve(@Model.OpenLogId)">Resolve &amp; Return to Ready</button>
                }
                @if (Model.OutOfService)
                {
                    <button type="button" class="vh-btn vh-btn--outline" onclick="vhSetService('@Model.VehicleId', false, @(Model.OpenLogId?.ToString() ?? "null"))">Return to Service</button>
                }
                else
                {
                    <button type="button" class="vh-btn vh-btn--danger" onclick="vhMarkOutOfService('@Model.VehicleId', @(Model.OpenLogId?.ToString() ?? "null"))">Mark Out of Service</button>
                }
            </div>

        </div>
    }

    @* History: everything recorded against this bus, whether or not an incident was
       involved, so retiring, grounding and returning it all appear in one place. *@
    <div class="vh-section-header"><span>History</span></div>
    <div class="vh-section-body">
        @if (Model.History.Count > 0)
        {
            <ul class="vh-history">
                @foreach (var h in Model.History)
                {
                    <li class="@(h.Refused ? "vh-history--refused" : "")">
                        <span class="vh-history-what">@h.What</span>
                        <span class="vh-history-meta">@h.Who &middot; @h.When</span>
                    </li>
                }
            </ul>
        }
        else
        {
            <div class="vh-detail-row vh-detail-empty">Nothing recorded for this bus yet.</div>
        }
    </div>

</div>