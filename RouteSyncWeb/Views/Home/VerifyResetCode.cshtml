@model FleetWise.Models.VerifyResetCodeViewModel
@{
    Layout = "~/Views/Shared/_LoginLayout.cshtml";
}

<div class="bg-wrapper">
    <div class="card">

        @* Left Panel *@
        <div class="left-panel">
            <div class="left-content">
                <img src="~/images/fleetwise-logo.png" alt="FleetWise Logo" class="logo" />
                <div class="brand-name">
                    <span class="brand-fleet">Route</span><span class="brand-wise">Sync</span>
                </div>
                <p class="brand-sub">Operator Dashboard</p>
                <p class="tagline">Drive Your Fleet with Intelligence</p>
            </div>
        </div>

        @* Right Panel *@
        <div class="right-panel">
            <h1 class="sign-in-title">Enter Code</h1>
            <p class="brand-sub" style="margin-bottom:18px;">
                If @Model.Email has an account, a 6-digit code is on its way. It expires in 10 minutes.
            </p>

            <form asp-action="VerifyResetCode" asp-controller="Home" method="post">
                @Html.AntiForgeryToken()
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="error-message">
                        @Html.ValidationSummary(true)
                    </div>
                }

                <input type="hidden" asp-for="Email" />

                <div class="input-group">
                    <span class="input-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#aaa" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                            <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                        </svg>
                    </span>
                    <input asp-for="Code" class="input-field" placeholder="6-digit code"
                           inputmode="numeric" maxlength="6" autocomplete="one-time-code"
                           style="letter-spacing:6px;font-weight:600;" />
                </div>
                <span asp-validation-for="Code" class="field-error"></span>

                <button type="submit" class="sign-in-btn">Verify Code</button>
            </form>

            <div class="forgot-password" style="display:flex;justify-content:space-between;margin-top:16px;">
                <form asp-action="ForgotPassword" asp-controller="Home" method="post" style="display:inline;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="Email" value="@Model.Email" />
                    <button type="submit" class="link-button">Send a new code</button>
                </form>
                <a asp-action="ForgotPassword" asp-controller="Home">Wrong email?</a>
            </div>
        </div>

    </div>
</div>
