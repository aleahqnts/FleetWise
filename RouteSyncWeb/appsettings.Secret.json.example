{
  "//": "COPY this file to 'appsettings.Secret.json' (same folder) and paste the real key.",
  "//key": "Supabase service (secret) key: Dashboard -> Project Settings -> API keys -> secret (sb_secret_...).",
  "//git": "appsettings.Secret.json is gitignored, so the real key never commits. This .example is safe to commit.",
  "//why": "Row level security locks the users table, so the web server needs the secret key to read it.",
  "Supabase": {
    "Key": "PASTE_SECRET_KEY_HERE"
  }
}
